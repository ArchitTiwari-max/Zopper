// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EXECUTIVE
}

enum AssignedStatus {
  Assigned
  In_Progress
  Completed
}

enum viststatus {
  PENDING_REVIEW
  REVIEWD
}


model UserRole {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  permissions String[]

  @@map("UserRole")
}

model User {
  id              String           @id @map("_id")
  email           String           @unique
  username        String           @unique
  password        String
  roles           String[]         @default(["EXECUTIVE"])
  permissions     String[]
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastLoginAt     DateTime?
  dostChats       DostChat[]
  holidayRequests HolidayRequest[]

  // New fields for unified schema:
  employee        Employee?

  @@map("User")
}

model Employee {
  id             String   @id @map("_id")
  name           String
  contact_number String
  region         String?
  designation    String?
  department     String?

  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])

  // store assignments
  employeeStores EmployeeStoreAssignment[]

  // Hierarchy Structure
  managerIds     String[]    @map("manager_ids")
  managers       Employee[]  @relation("EmployeeHierarchy", fields: [managerIds], references: [id])
  subordinateIds String[]    @map("subordinate_ids")
  subordinates   Employee[]  @relation("EmployeeHierarchy", fields: [subordinateIds], references: [id])

  // Relations: Activities logged by this Employee
  visits            Visit[]            @relation("EmployeeCreatedVisits")
  digitalVisits     DigitalVisit[]     @relation("EmployeeCreatedDigitalVisits")
  stakeholderVisits StakeholderVisit[] @relation("EmployeeCreatedStakeholderVisits")
  visitPlans        VisitPlan[]        @relation("EmployeeVisitPlans")
  assigned          Assigned[]         @relation("EmployeeAssigned")
  employeeVisits    EmployeeVisit[]    @relation("EmployeeVisits")
  dostChats         DostChat[]

  // Relations: Reviews done by this Employee
  reviewedVisits            Visit[]            @relation("EmployeeReviewedVisits")
  reviewedDigitalVisits     DigitalVisit[]     @relation("EmployeeReviewedDigitalVisits")
  reviewedStakeholderVisits StakeholderVisit[] @relation("EmployeeReviewedStakeholderVisits")

  @@map("Employee")
}

model EmployeeStoreAssignment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @map("executiveId")
  storeId     String
  assignedAt  DateTime @default(now())
  isFlagged   Boolean  @default(false)

  employee    Employee @relation(fields: [employeeId], references: [id])
  store       Store     @relation(fields: [storeId], references: [id])

  @@unique([employeeId, storeId])
  @@map("ExecutiveStoreAssignment")
}

enum PartnerBrandType {
  A_PLUS @map("A+")
  A
  B
  C
  D
  NONE
}

enum Priority {
  p1
  p2
  p3
}

enum PlanType {
  ADLD
  SP
  COMBO
  EW
  EW_1YR @map("Ew - 1yr")
  EW_2YR @map("Ew - 2yr")
  EW_3YR @map("Ew - 3yr")
  EW_4YR @map("Ew - 4yr")
  NA
}

model Store {
  id              String                     @id @map("_id")
  storeName       String
  city            String?
  fullAddress     String?
  latitude        Float? // Geocoded latitude (Google Places API)
  longitude       Float? // Geocoded longitude (Google Places API)
  visits          Visit[]
  digitalVisits   DigitalVisit[]
  employeeStores  EmployeeStoreAssignment[]
  employeeVisits  EmployeeVisit[]
  salesRecords    SalesRecord[]
  alignment       StoreAlignment?
  storeCategory   String?
  storeChannel    String?
  cityTier        String?
  state           String?
  priority        Priority?
  targets         StoreTarget[]
  storeBrands     StoreBrand[]
  zonalManager    String?
  clusterManager  String?
}

model Brand {
  id           String        @id @map("_id")
  brandName    String        @unique
  salesRecords SalesRecord[]
  storeBrands  StoreBrand[]
  targets      StoreTarget[]
  stakeholderVisits StakeholderVisit[]
}

model StoreBrand {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  storeId      String
  brandId      String
  storeBrandId String?
  brandType    PartnerBrandType @default(NONE)

  store Store @relation(fields: [storeId], references: [id])
  brand Brand @relation(fields: [brandId], references: [id])

  @@unique([storeId, brandId])
  @@map("StoreBrand")
}

model ProductCategory {
  id           String        @id @map("_id")
  categoryName String        @unique
  salesRecords SalesRecord[]
}

model ProductSubCategory {
  id           String        @id @map("_id")
  name         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  salesRecords SalesRecord[]

  @@map("ProductSubCategory")
}

model SalesRecord {
  id                   String  @id @default(auto()) @map("_id") @db.ObjectId
  storeId              String
  brandId              String
  productCategoryId    String
  productSubCategoryId String  @default("N/A")
  year                 Int
  modelName            String  @default("N/A")
  planType             PlanType @default(NA)

  monthlySales Json //Store summary of all 12 months Each month contains deviceSales, planSales, attachPct, revenue etc. EX. [{ month: 1, deviceSales: X, planSales: Y, attachPct: Z, revenue: R }, ..., { month: 12, ... }]
  dailySales   Json // Stores daily sales data grouped by month (e.g., { "1": [{ date: "01-01-2025", planSales: 1, revenue: 1200 }], "2": [{ date: "01-02-2025", planSales: 1, revenue: 900 }] }), tracking only planSales and revenue for each day.

  store              Store               @relation(fields: [storeId], references: [id])
  brand              Brand               @relation(fields: [brandId], references: [id])
  productCategory    ProductCategory     @relation(fields: [productCategoryId], references: [id])
  productSubCategory ProductSubCategory  @relation(fields: [productSubCategoryId], references: [id])

  @@unique([storeId, brandId, productCategoryId, productSubCategoryId, modelName, planType, year])
  // Indexes for faster analytics queries
  @@index([storeId, year])
  @@index([storeId, brandId, year])
  @@index([brandId, productCategoryId, year])
}

model StoreTarget {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  storeId            String
  brandId            String
  month              Int    // Month (1-12)
  year               Int    // Year (e.g. 2026)
  targetRevenue      Float?
  targetUnits        Int?
  achievementRevenue Float? // Actual achievement (revenue) — updated via Xiaomi import
  achievementUnits   Int?   // Actual achievement (units) — updated via Xiaomi import

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([storeId, brandId, month, year])
  @@index([storeId, year])
  @@index([brandId])
  @@map("StoreTarget")
}

//
// Visit & Issue
//

model Visit {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  personMet         Json // [{ name: "Rajesh", designation: "Manager", phoneNumber: "1234567890" }]
  POSMchecked       Boolean?   @map("displayChecked") // Point of Sale Material availability check (nullable for backward compatibility)
  remarks           String?
  imageUrls         String[] // Array of image URLs
  visitDate         DateTime? // Actual date when visit occurred (nullable for backward compatibility during migration)
  nextScheduledDate DateTime? // Optional rescheduled/next visit date
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  status            viststatus @default(PENDING_REVIEW)
  adminComment      String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByEmployee Employee? @relation("EmployeeReviewedVisits", fields: [reviewedByAdminId], references: [id])
  // relations
  executiveId       String
  employee          Employee?  @relation("EmployeeCreatedVisits", fields: [executiveId], references: [id])

  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  brandIds          String[]
  brandVisitDetails Json? // [{ brandId, brandName, POSMchecked, remarks, imageUrls, issues }]

  issues        Issue[] // One Visit can have multiple Issues or none
  notifications Notification[] // Notifications related to this visit

  // Critical performance indexes based on actual queries
  @@index([executiveId, visitDate])
  @@index([executiveId, createdAt])
  @@index([storeId])
}

model EmployeeVisit {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  personMet   Json
  POSMchecked Boolean?  @map("displayChecked")
  remarks     String?
  imageUrls   String[]
  visitDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employeeId  String    @map("adminId")
  employee    Employee  @relation("EmployeeVisits", fields: [employeeId], references: [id])

  storeId  String
  store    Store    @relation(fields: [storeId], references: [id])
  brandIds String[]

  @@index([employeeId, visitDate])
  @@index([storeId])
  @@map("AdminVisit")
}

enum IssueStatus {
  Pending
  Assigned
  Resolved
}

model Issue {
  id        String      @id @map("_id")
  details   String
  createdBy Role?       @default(EXECUTIVE) // Who created the issue: ADMIN or EXECUTIVE
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    IssueStatus @default(Pending)

  // relations to either Physical Visit or Digital Visit
  visitId        String?       @db.ObjectId
  visit          Visit?        @relation(fields: [visitId], references: [id])
  digitalVisitId String?       @db.ObjectId
  digitalVisit   DigitalVisit? @relation(fields: [digitalVisitId], references: [id])
  stakeholderVisitId String?   @db.ObjectId
  stakeholderVisit StakeholderVisit? @relation(fields: [stakeholderVisitId], references: [id])

  assigned      Assigned[] // One Issue can have multiple Assigned records
  notifications Notification[] // Notifications related to this issue

  // Critical performance indexes based on actual queries
  @@index([visitId])
  @@index([digitalVisitId])
}

model Assigned {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  adminComment String?
  createdAt    DateTime       @default(now())
  status       AssignedStatus @default(Assigned)

  // relation to Issue
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id])

  // relation to Employee
  executiveId String
  employee    Employee? @relation("EmployeeAssigned", fields: [executiveId], references: [id])

  // relation to AssignReport
  assignReport  AssignReport?
  notifications Notification[] // Notifications related to this assignment

  // Critical performance indexes based on actual queries
  @@index([executiveId, status])
}

model AssignReport {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  remarks              String // Required field
  personMetName        String? // Optional field
  personMetDesignation String? // Optional field
  photoUrls            String[] // Array of photo URLs (optional)
  createdAt            DateTime @default(now())

  // relation to Assigned task
  assignedId String   @unique @db.ObjectId
  assigned   Assigned @relation(fields: [assignedId], references: [id], onDelete: Cascade)

  @@map("AssignReport")
}

//
// Digital Visit (separate lightweight schema for remote connects)
//

model DigitalVisit {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  connectDate       DateTime // date of call/connect
  personMet         Json // [{ name, designation, phoneNumber }]
  remarks           String // required remarks for digital visit
  status            viststatus @default(PENDING_REVIEW)
  adminComment      String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByEmployee Employee? @relation("EmployeeReviewedDigitalVisits", fields: [reviewedByAdminId], references: [id])

  executiveId String
  employee    Employee? @relation("EmployeeCreatedDigitalVisits", fields: [executiveId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  issues            Issue[]
  brandVisitDetails Json? // [{ brandId, brandName, remarks, issues }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([executiveId])
  @@index([executiveId, connectDate])
  @@index([storeId])
}

//
// Visit Plan (PJP)
//

enum VisitPlanStatus {
  SUBMITTED
  COMPLETED
}

model VisitPlan {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  executiveId      String
  employee         Employee?       @relation("EmployeeVisitPlans", fields: [executiveId], references: [id])
  storeIds         String[]
  storesSnapshot   Json? // Optional snapshot of store details at submission time
  status           VisitPlanStatus @default(SUBMITTED)
  submittedAt      DateTime        @default(now())
  reviewedAt       DateTime?
  reviewNote       String?
  plannedVisitDate DateTime // The date when visits should be conducted

  // Timestamps for better caching
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin creation support
  createdByAdminId String? // Admin ID who created this plan (null for executive-created)
  adminComment     String? // Comment from admin when creating the plan
  createdByRole    Role    @default(EXECUTIVE) // ADMIN or EXECUTIVE

  // Notifications related to this plan
  notifications Notification[]

  // Reason why PJP was not followed
  pjpNotFollowedReason String?

  // Reason for being on leave (e.g., "I am on Off", "Working on Business Alignment")
  leaveReason String?

  @@index([executiveId, submittedAt])
  @@index([createdByAdminId, submittedAt])
  @@map("VisitPlan")
}

model OTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("Otp")
}

//
// Notification System
//

enum NotificationType {
  VISIT_SUBMITTED // Executive submits a visit -> Admin
  VISIT_REVIEWED // Admin reviews a visit -> Executive
  ISSUE_REPORTED // Executive reports an issue -> Admin
  ISSUE_ASSIGNED // Admin assigns issue -> Executive
  ISSUE_STATUS_UPDATED // Executive updates issue status -> Admin
  ISSUE_RESOLVED // Executive resolves issue -> Admin
  ADMIN_COMMENT_ADDED // Admin adds comment -> Executive
  SYSTEM_ANNOUNCEMENT // System-wide announcements
  VISIT_PLAN_SUBMITTED // Executive submits a PJP/visit plan -> Admin
  VISIT_PLAN_ASSIGNED // Admin assigns visit plan to Executive -> Executive
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Notification {
  id       String               @id @default(auto()) @map("_id") @db.ObjectId
  title    String // Short notification title
  message  String // Detailed notification message
  type     NotificationType // Type of notification
  status   NotificationStatus   @default(UNREAD)
  priority NotificationPriority @default(MEDIUM)

  // Recipient information
  recipientId   String // User ID who receives the notification
  recipientRole Role // ADMIN or EXECUTIVE

  // Sender information (optional for system notifications)
  senderId   String? // User ID who triggered the notification
  senderRole Role? // ADMIN or EXECUTIVE

  // Related entity references (for deep linking)
  visitId     String? @db.ObjectId // Related visit ID
  issueId     String? // Related issue ID
  assignedId  String? @db.ObjectId // Related assignment ID
  visitPlanId String? @db.ObjectId // Related visit plan (PJP) ID

  // Metadata
  metadata  Json? // Additional contextual data
  actionUrl String? // Deep link to related page

  // Timestamps
  createdAt  DateTime  @default(now())
  readAt     DateTime? // When notification was read
  archivedAt DateTime? // When notification was archived
  expiresAt  DateTime? // Optional expiration for temporary notifications

  // Relations (optional - for referential integrity)
  visit     Visit?     @relation(fields: [visitId], references: [id])
  issue     Issue?     @relation(fields: [issueId], references: [id])
  assigned  Assigned?  @relation(fields: [assignedId], references: [id])
  visitPlan VisitPlan? @relation(fields: [visitPlanId], references: [id])

  // Indexes for performance
  @@index([recipientId, status, createdAt])
  @@index([type, createdAt])
  @@index([recipientId, recipientRole])
  @@map("Notification")
}

//
// Dost chat memory
//
// Dost chat memory
//
model DostChat {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  question    String
  answerText  String?
  payload     Json?
  executiveId String
  userId      String
  createdAt   DateTime @default(now())

  employee  Employee? @relation(fields: [executiveId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([executiveId, createdAt])
  @@map("DostChat")
}

//
// Brand Dump Import
//

model BrandDump {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  brandName  String // Godrej, Samsung, Havells, etc.
  uploadedAt DateTime @default(now())

  // Godrej specific columns (22 fields)
  warrantyActivationCode String?
  customerPremium        String?
  zopperPlanDuration     String?
  warrantyPurchaseDate   String?
  warrantyStartDate      String?
  technicianUserId       String?
  technicianName         String?
  serviceCentreName      String?
  businessName           String?
  pinCode                String?
  customerCity           String?
  customerState          String?
  productPurchasedDate   String?
  applianceModelName     String?
  productCategoryId      String?
  modelCode              String?
  productCategory        String?
  productCoverage        String?
  productSerialNumber    String?
  branch                 String?
  pocName                String?
  channel                String?

  // For future brands (Samsung, Havells), we can add their specific columns
  // or use a JSON field for flexibility
  additionalData Json? // For any extra brand-specific data

  @@index([brandName, uploadedAt])
  @@map("BrandDump")
}

//
// Holiday Management
//

model Holiday {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime // Holiday date (stored as UTC date)
  name        String? // Optional holiday name (e.g., "Christmas", "New Year")
  description String? // Optional description
  isRecurring Boolean  @default(false) // Whether this holiday repeats yearly
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String? // Admin ID who created this holiday

  // Index for efficient date lookups
  @@index([date])
  @@map("Holiday")
}

enum HolidayRequestType {
  VACATION
  WEEK_OFF
}

enum HolidayRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model HolidayRequest {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  executiveName String // Name of the executive requesting holiday
  reason        String // Reason for the holiday
  startDate     DateTime // Start date of holiday
  endDate       DateTime // End date of holiday
  type          HolidayRequestType?  @default(VACATION)
  status        HolidayRequestStatus @default(PENDING)
  submittedAt   DateTime             @default(now())
  reviewedAt    DateTime? // When admin reviewed the request
  reviewedBy    String? // Admin ID who reviewed
  adminComment  String? // Admin's comment on the request

  // Relations
  userId  String // Executive user who submitted the request
  user    User    @relation(fields: [userId], references: [id])
  storeId String? // Optional store context

  replacementAvailable Boolean? // Is a replacement available?

  // Indexes for performance
  @@index([userId, submittedAt])
  @@index([status, submittedAt])
  @@map("HolidayRequest")
}

//
// Godrej SFDC Data
//

model GodrejSfdc {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  planId            String // Plan ID
  phone             String // Customer Phone
  contractBookingId String // Contract Booking ID
  customerName      String? // Customer Name (optional, added later)
  uploadedAt        DateTime @default(now())

  // Index for efficient sorting by upload date
  @@index([uploadedAt])
  @@map("GodrejSfdc")
}

model StoreAlignment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id])

  // Dynamic staffing data stored as flexible JSON
  // Supports multiple names/contacts per role
  storeLevel       Json
  stakeholderLevel Json

  updatedAt DateTime @updatedAt
  updatedBy String? // ID of the user who last updated the data

  @@map("StoreAlignment")
}

// ─── Store Chain Role Configuration ──────────────────────────────────────────
// Admin-managed role templates per store chain (e.g. CROMA, VS, HITACHI)
// Stores are auto-matched by prefix; excluded store IDs can be managed per chain.
model StoreChainConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  chainName        String   @unique // Display name: "CROMA", "VS", "HITACHI"
  prefix           String // Matching prefix (uppercase): "CROMA", "VS"
  excludedStoreIds String[] // Store IDs manually removed from this chain

  // JSON arrays of { role: string, weight: number }
  storeRoles       Json // Store-level roles
  stakeholderRoles Json // Stakeholder-level roles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("StoreChainConfig")
}

// ─── Distance Cache ──────────────────────────────────────────────────────────
// Caches driving distances (in km) queried from Google Maps APIs to save costs
// origin and destination are stored as "lat,lng" strings to avoid float precision issues
model DistanceCache {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  origin      String // "lat,lng"
  destination String // "lat,lng"
  distanceKm  Float
  createdAt   DateTime @default(now())

  @@unique([origin, destination])
  @@map("DistanceCache")
}

//
// Stakeholder Master (Admin-managed list of stakeholders)
// Admin creates stakeholders with name, designation, city
// Executives fetch this list to show cards and log visits against them
//
model Stakeholder {
  id           String   @id @map("_id")
  designation  String
  brands       String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  // Admin user ID who created this stakeholder

  // Back-relation to visits
  stakeholderVisits StakeholderVisit[]
  // Assignments to executives


  @@index([isActive])
  @@map("Stakeholder")
}



//
// Stakeholder Visit
// Store-less, POSM-less visit specifically for stakeholder meetings
// Admin adds stakeholder (designation) from their side
//
model StakeholderVisit {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId

  // Link to Stakeholder master (optional — backward compatible)
  stakeholderId          String?
  stakeholder            Stakeholder? @relation(fields: [stakeholderId], references: [id])

  // Stakeholder details (denormalized for display even without master record)
  brandId                String
  brand                  Brand      @relation(fields: [brandId], references: [id])
  stakeholderDesignation String

  // Visit details (filled by executive via form — mirrors physical Visit)
  state             String
  visitDate         DateTime?  // Actual date when visit occurred
  personMet         Json       // [{ name: "...", designation: "...", phoneNumber: "..." }]
  remarks           String?
  imageUrls         String[]   // Array of uploaded image URLs
  nextScheduledDate DateTime?  // Optional next visit date
  brandIds          String[]   @default([])
  brandVisitDetails Json?      // Optional brand-level details

  // Status & review
  status            viststatus @default(PENDING_REVIEW)
  adminComment      String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByEmployee Employee? @relation("EmployeeReviewedStakeholderVisits", fields: [reviewedByAdminId], references: [id])

  // Relations
  executiveId       String
  employee          Employee?  @relation("EmployeeCreatedStakeholderVisits", fields: [executiveId], references: [id])

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  issues            Issue[]    // Issues logged during this stakeholder visit

  @@index([executiveId, visitDate])
  @@index([executiveId, createdAt])
  @@index([stakeholderId])
  @@map("StakeholderVisit")
}

model Client {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId     String   @unique
  clientSecret String
  appName      String
  redirectUris String[]
  createdAt    DateTime @default(now())

  @@map("Client")
}

model AuthorizationCode {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  clientId    String
  userId      String
  redirectUri String
  scope       String?
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("AuthorizationCode")
}


